# Copy to .env and fill in to switch services from DEMO to LIVE mode.
# Only EXPO_PUBLIC_* values are bundled into the app — they must be public/publishable values.
# Secret keys belong in Supabase Edge Function secrets (see docs/PRODUCTION_SERVICES.md).

# Supabase (Auth, Postgres, Storage). The anon key is designed to be public; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the AeroVerse Edge Functions, e.g. https://<project>.functions.supabase.co
EXPO_PUBLIC_API_BASE_URL=

# Stripe publishable key (pk_...). Never put the secret key here.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
